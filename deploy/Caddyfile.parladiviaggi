# Bloque de Caddy para Parla di Viaggi. Se agrega al final de /etc/caddy/Caddyfile.
# Cloudflare hace de proxy (SSL "Full (strict)") con un certificado de origen de Cloudflare.
# Cuando se mude el dominio principal, se agregan parladiviaggi.com.ar y www acá.

nuevo.parladiviaggi.com.ar {
	tls /etc/caddy/certs/parladiviaggi.com.ar.pem /etc/caddy/certs/parladiviaggi.com.ar.key
	encode zstd gzip

	root * /var/www/parladiviaggi/current/dist/client

	# Archivos con hash de Astro: se cachean un año.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Páginas y archivos estáticos generados en el build.
	@static file {
		try_files {path} {path}/index.html {path}.html
	}
	handle @static {
		rewrite * {http.matchers.file.relative}
		file_server
	}

	# Todo lo demás (admin y API en la fase 2, y las páginas 404) va a Node.
	handle {
		reverse_proxy 127.0.0.1:4321
	}
}
