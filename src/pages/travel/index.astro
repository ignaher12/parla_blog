---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { SITE_TITLE } from "../../consts";
import { precioTexto, rangoFechas } from "../../lib/formato";
import { getMedia, mediaSrcset, mediaUrl } from "../../lib/media";
import { listarViajes } from "../../lib/viajes";

const posts = listarViajes({ soloPublicados: true })
    .sort((a, b) => Number(b.destacado) - Number(a.destacado))
    .map((v) => ({ ...v, foto: getMedia(v.portada) }));
---

<!doctype html>
<html lang="es-AR">
    <head>
        <BaseHead
            title={`Próximos viajes | ${SITE_TITLE}`}
            description="Salidas grupales y paquetes especiales de Parla di Viaggi, agencia de viajes de Mar del Plata."
        />
        <style>
            main {
                width: 960px;
            }
            ul {
                display: flex;
                flex-wrap: wrap;
                gap: 2rem;
                list-style-type: none;
                margin: 0;
                padding: 0;
            }
            ul li {
                width: calc(50% - 1rem);
            }
            ul li * {
                text-decoration: none;
                transition: 0.2s ease;
            }
            ul li:first-child {
                width: 100%;
                margin-bottom: 1rem;
                text-align: center;
            }
            ul li:first-child img {
                width: 100%;
            }
            ul li:first-child .title {
                font-size: 2.369rem;
            }
            ul li img {
                margin-bottom: 0.5rem;
                border-radius: 12px;
                width: 100%;
                height: auto;
                aspect-ratio: 2 / 1;
                object-fit: cover;
            }
            ul li a {
                display: block;
            }
            .title {
                margin: 0;
                color: rgb(var(--black));
                line-height: 1;
            }
            .date {
                margin: 0;
                color: rgb(var(--gray));
            }
            ul li a:hover h4,
            ul li a:hover .date {
                color: rgb(var(--accent));
            }
            ul a:hover img {
                box-shadow: var(--box-shadow);
            }
            @media (max-width: 720px) {
                ul {
                    gap: 0.5em;
                }
                ul li {
                    width: 100%;
                    text-align: center;
                }
                ul li:first-child {
                    margin-bottom: 0;
                }
                ul li:first-child .title {
                    font-size: 1.563em;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <WhatsAppButton />
        <main>
            <section>
                <ul>
                    {
                        posts.length === 0 ? (
                            <li>
                                <p>Pronto vamos a publicar nuevas salidas. ¡Escribinos por WhatsApp!</p>
                            </li>
                        ) : (
                            posts.map((v) => (
                                <li>
                                    <a href={`/travel/${v.slug}/`}>
                                        {v.foto && (
                                            <img
                                                src={mediaUrl(v.foto.id, 960)}
                                                srcset={mediaSrcset(v.foto)}
                                                sizes="(max-width: 720px) 100vw, 960px"
                                                alt={v.foto.alt || v.titulo}
                                                loading="lazy"
                                            />
                                        )}
                                        <h4 class="title">{v.titulo}</h4>
                                        <p class="date">
                                            {[
                                                rangoFechas(v.fecha_salida, v.fecha_regreso) || v.destino,
                                                precioTexto(v.precio, v.moneda) && `desde ${precioTexto(v.precio, v.moneda)}`,
                                            ]
                                                .filter(Boolean)
                                                .join(" · ")}
                                        </p>
                                    </a>
                                </li>
                            ))
                        )
                    }
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
