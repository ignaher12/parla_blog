---
// Vista previa de un viaje desde el panel (muestra también los ocultos).
import DetalleViaje from "../../../components/DetalleViaje.astro";
import { viajePorSlug } from "../../../lib/viajes";

const viaje = viajePorSlug(Astro.params.slug ?? "", false);
